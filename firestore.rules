rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Règles permissives pour le développement - À SÉCURISER EN PRODUCTION
    match /{document=**} {
      // Permettre à tous les utilisateurs authentifiés de lire et écrire
      allow read, write: if request.auth != null;
    }
  }
}